{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "extends": [],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "plugins": [],
  "rules": {
    "@typescript-eslint/no-unused-vars": "off",
    "no-unused-vars": "off",
    "no-console": "off",
    "no-debugger": "off",
    "no-undef": "off",
   
    "no-constant-condition": "off",
    "no-empty": "off",
    "no-extra-semi": "off",
    "no-irregular-whitespace": "off",
    "no-mixed-spaces-and-tabs": "off",
    "no-redeclare": "off",
    "no-unreachable": "off",
    "prefer-const": "off",
    "no-var": "off"
  }
}
  