{
    "env": {
      "browser": true,
      "es2021": true,
      "node": true
    },
    "extends": [
      "eslint:recommended",
      "plugin:react/recommended"
    ],
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module"
    },
    "plugins": [
      "react",
      "react-hooks"
    ],
    "rules": {
      "react/no-unescaped-entities": "off",
      "react/no-unknown-property": "off",
      "react/react-in-jsx-scope": "off",
      "react/jsx-key": "warn",
      "react/display-name": "off",
      "react-hooks/exhaustive-deps": "off",
      "no-useless-catch": "off",
      "no-empty": "off",
      "no-dupe-keys": "off",
      "no-unreachable": "off",
      "no-extra-semi": "off",
      "no-async-promise-executor": "off",
      "import/no-unresolved": "off"
    },
    "settings": {
      "react": {
        "version": "detect"
      }
    }
  }
  